# ==============================================================
#   ENHANCED Dante SOCKS5 Configuration
#   Built for High-Stability Copy Trading Infrastructure
#   With Connection Limits, Logging, and Timeout Settings
# ==============================================================

# -------- LOGGING (Enhanced for Debugging) --------
# Log to both syslog and file (multiple targets on one line)
logoutput: syslog /var/log/danted.log

# -------- NETWORK BINDING --------
# Listen on all interfaces (will be auto-detected by installer)
internal: 0.0.0.0 port = 1080

# Use VM's default outbound interface (will be auto-detected by installer)
external: eth0

# -------- AUTHENTICATION --------
# Require username/password auth — required for Proxifier compatibility
socksmethod: username

# Client handshake uses no-auth (normal for SOCKS5 client hello)
clientmethod: none

# Privileged operations run as root
user.privileged: root

# Unprivileged operations run as nobody
user.notprivileged: nobody

# -------- CONNECTION LIMITS (Prevent Resource Exhaustion) --------
# Maximum 10,000 concurrent connections (prevents memory exhaustion)
maxchild: 10000

# Per-IP connection limit (prevents single client DoS)
# Allows max 1000 connections per IP address
#clientpolicies: max_connections 1000

# -------- TIMEOUT SETTINGS (Prevent Zombie Connections) --------
# Close idle connections after 10 minutes (600 seconds)
timeout.io: 600

# TCP connection timeout (30 seconds)
timeout.connect: 30

# Negotiate timeout (30 seconds)
timeout.negotiate: 30

# Note: tcp.keepalive is not a valid Dante 1.4 directive — omitted

# -------- CLIENT ACCESS RULES --------
# Allow clients from anywhere to connect
# (Update to restrict if needed)
client pass {
    from: 0.0.0.0/0 to: 0.0.0.0/0
    log: connect disconnect error
}

# -------- SOCKS5 RULES --------
# Require username auth on all SOCKS connections (Proxifier compatibility)
socks pass {
    from: 0.0.0.0/0 to: 0.0.0.0/0
    socksmethod: username
    protocol: tcp
    log: connect disconnect error
}

# -------- DENY RULE (Fail Secure) --------
# Block anything not explicitly allowed
socks block {
    from: 0.0.0.0/0 to: 0.0.0.0/0
    log: connect error
}

